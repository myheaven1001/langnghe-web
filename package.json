{
  "name": "langnghe-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "check:migrations": "node scripts/check-migration-order.mjs",
    "seed:staging": "node --env-file=.env.staging.local scripts/seed-staging.mjs",
    "backup:prod": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-db.ps1",
    "db:push:staging": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db-push.ps1 -Target staging",
    "db:push:prod": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db-push.ps1 -Target production",
    "db:forget-passwords": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db-forget-passwords.ps1",
    "backup:staging": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-db.ps1 -Target staging"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.0.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "eslint-config-prettier": "^10.1.8",
    "pg": "^8.23.1",
    "pg-copy-streams": "^7.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.118.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
